function getDayIndex() {
  const base = new Date("2025-01-01");
  const today = new Date(); today.setHours(0,0,0,0);
  return Math.floor((today - base) / 86400000);
}

function seededShuffle(arr, seed) {
  const result = [...arr]; let s = seed;
  for (let i = result.length - 1; i > 0; i--) {
    s = (s * 1664525 + 1013904223) & 0xffffffff;
    const j = Math.abs(s) % (i + 1);
    [result[i], result[j]] = [result[j], result[i]];
  }
  return result;
}

function getTodayWisdom() {
  const dayIdx = getDayIndex();
  const cycle = Math.floor(dayIdx / WISDOMS.length);
  const pos = dayIdx % WISDOMS.length;
  return seededShuffle(WISDOMS, cycle * 999983 + 7)[pos];
}

function getTodayPalette() {
  const d = new Date();
  return PALETTES[(d.getFullYear() * 13 + d.getMonth() * 4 + Math.floor(d.getDate()/8)) % PALETTES.length];
}

